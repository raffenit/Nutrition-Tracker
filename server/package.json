{
  "name": "nutrition-tracker-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:test": "tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/index.js",
    "test:run": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test $(find dist-test -name '*.test.js' | sort)",
    "test": "npm run check && npm run check:test && npm run test:run"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "busboy": "1.6.0",
    "pdf-parse": "2.4.5",
    "sharp": "^0.35.5",
    "tesseract.js": "7.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/busboy": "1.5.4",
    "@types/node": "26.6.3",
    "@types/web-push": "^3.6.4",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "tesseract.js@7.0.0": true
  }
}
