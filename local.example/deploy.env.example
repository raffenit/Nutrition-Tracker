# Copy to local/deploy.env (gitignored). Read by ./deploy.sh only — not the app container.

# Optional: URLs printed when deploy finishes
REMOTE_BASE_URL=http://YOUR_SERVER_TAILSCALE_IP:3010

# Only if infrastructure is NOT ../infrastructure relative to this repo.
# Needed for ./deploy.sh --infra when the default path is wrong.
# INFRA_COMPOSE_DIR=/path/to/infrastructure

# Default 3010 — change only if Caddy publishes a different host port
# NUTRITION_PORT=3010
