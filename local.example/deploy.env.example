# Copy to local/deploy.env (gitignored) and customize.

# Shown at the end of ./deploy.sh (remote access hint)
# REMOTE_BASE_URL=http://YOUR_TAILSCALE_IP:3010

# If infrastructure is not ../infrastructure relative to this repo
# INFRA_COMPOSE_DIR=/path/to/your/infrastructure

# Override health check / printed local URL port (default 3010)
# NUTRITION_PORT=3010
