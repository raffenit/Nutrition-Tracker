# App runtime (Docker Compose). Copy to .env — not committed.
# Set once by whoever runs the server; all household users share this instance.

# STANDALONE = bundled Caddy in this repo (./deploy.sh)
# EXTERNAL   = shared homelab Caddy + media-network (./deploy.sh)
CADDY_STYLE=STANDALONE

TZ=America/Chicago

# Label OCR: Docker image includes EasyOCR (PyTorch). Tesseract always runs; EasyOCR competes via parse score.
# First label scan downloads models into ./data/easyocr-models (persisted on ./data volume).
# Set EASYOCR_ENABLED=0 to skip neural OCR at runtime (Tesseract + focus crops only; saves CPU/RAM).
EASYOCR_ENABLED=1
# EASYOCR_MAX_VARIANTS=4  — neural OCR image cap (default 4). EASYOCR_AB=1 enables a slower second pass.
# TESSERACT_MAX_VARIANTS=12 — preprocessed image cap for Tesseract (default 12). TESSERACT_DUAL_PSM=1 runs two page modes.

# Optional: one free key for the whole server (not per user).
# https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Tailscale server URL — how phones/tablets on YOUR tailnet reach this app (not the public internet).
# Scheme + hostname only; do not add :3010 here (use NUTRITION_PORT below for HTTP over Tailscale IP).
#
# Start with HTTP + Tailscale IP (see README Step 6):
#   TAILSCALE_SERVER_URL=http://100.x.x.x
#   NUTRITION_PORT=3010
#
# After HTTPS is set up (README Step 8 — MagicDNS + tailscale serve):
#   TAILSCALE_SERVER_URL=https://YOUR-MACHINE.your-tailnet.ts.net
#   (https:// recommended; bare *.ts.net hostnames are treated as HTTPS — no :3010)
#
# Legacy env name (still supported): PUBLIC_URL
TAILSCALE_SERVER_URL=http://100.x.x.x
NUTRITION_PORT=3010

# Optional: Web Push (goal alerts on phone). Requires HTTPS Tailscale URL above. Generate once:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: ./deploy.sh only (ignored by the app container)
# INFRA_COMPOSE_DIR=/path/to/infrastructure
# DEPLOY_COMMIT_MSG=Deploy nutrition tracker updates
