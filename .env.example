# App runtime (Docker Compose). Copy to .env — not committed.
# Set once by whoever runs the server; all household users share this instance.

# STANDALONE = bundled Caddy in this repo (./standalone-deploy.sh)
# EXTERNAL   = shared homelab Caddy + media-network (./external-deploy.sh)
CADDY_STYLE=STANDALONE

TZ=America/Chicago

# Optional: one free key for the whole server (not per user).
# https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Required for family/kiosk links and Web Push. Prefer Tailscale HTTPS (see README):
#   sudo tailscale serve --bg http://127.0.0.1:3010
#   PUBLIC_URL=https://YOUR-MACHINE.your-tailnet.ts.net
PUBLIC_URL=https://YOUR-MACHINE.your-tailnet.ts.net

# Optional: Web Push (goal alerts on phone). Generate once:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
